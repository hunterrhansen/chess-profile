# /opt/knightly/<env>/.env on the server (chmod 600). One per environment: staging, production.
# docs/deploy.md says where each value comes from.

KNIGHTLY_ENV=production
KNIGHTLY_MODE=server

# Supabase › Connect › Session pooler (port 5432). Session mode, not transaction mode (6543):
# each connection sets which user it acts for, and that must stay with the connection.
KNIGHTLY_DATABASE_URL=postgresql://postgres.<project ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Clerk › API keys of this environment's instance (production: pk_live_...).
CLERK_PUBLISHABLE_KEY=
# Clerk › Webhooks › an endpoint https://<your domain>/api/webhooks/clerk for user.deleted.
CLERK_WEBHOOK_SECRET=
# Only accept sign-in tokens made for this site.
KNIGHTLY_ALLOWED_ORIGINS=https://<your domain>

# Cloudflare › Zero Trust › Networks › Tunnels › this environment's tunnel › its token.
TUNNEL_TOKEN=

# Chess.com asks API clients for a contact in the User-Agent.
KNIGHTLY_CONTACT=<your email>

# Optional monitoring.
SENTRY_DSN=
KNIGHTLY_HEARTBEAT_URL=

# The worker's CPU share on this machine (production 2, staging 0.5).
WORKER_CPUS=2
