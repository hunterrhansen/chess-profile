# Copy to .env (gitignored) and fill in; run with: uv run --env-file .env knightly serve
# Clerk, from the dashboard's API keys page (development instance: pk_test_ / sk_test_).
CLERK_PUBLISHABLE_KEY=
# Optional: Clerk's JWT public key (PEM), to check tokens without fetching Clerk's JWKS.
CLERK_JWT_KEY=
# Optional: the signing secret of a webhook for user.deleted, so deleting an account deletes its data.
CLERK_WEBHOOK_SECRET=
# Optional: only accept tokens made for these sites (comma-separated).
KNIGHTLY_ALLOWED_ORIGINS=
