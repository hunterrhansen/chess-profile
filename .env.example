# Copy to .env (gitignored) and fill in; run with: uv run --env-file .env knightly serve
# The web app reads the publishable key from the server (/api/config): no web/.env.local needed.
# Clerk, from the dashboard's API keys page (development instance: pk_test_ / sk_test_).
CLERK_PUBLISHABLE_KEY=
# Optional: Clerk's JWT public key (PEM), to check tokens without fetching Clerk's JWKS.
CLERK_JWT_KEY=
# Optional: the signing secret of a webhook for user.deleted, so deleting an account deletes its data.
CLERK_WEBHOOK_SECRET=
# Optional: only accept tokens made for these sites (comma-separated).
KNIGHTLY_ALLOWED_ORIGINS=
# Optional: who CLI commands act for when --user isn't given (default: local), e.g. your own
# Clerk user id once `knightly users link local user_...` has moved your history to it.
KNIGHTLY_USER=
# On a server: which one this is (tags errors), and where to report them.
KNIGHTLY_ENV=
SENTRY_DSN=
# Pinged by the worker every few minutes (e.g. a Better Stack heartbeat), so a dead worker alerts.
KNIGHTLY_HEARTBEAT_URL=
